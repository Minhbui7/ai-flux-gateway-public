<policies>
  <inbound>
    <choose>
      <when condition='@(context.Request.OriginalUrl.Path != "/dev/v1/models" &amp;&amp; context.Request.OriginalUrl.Path != "/dev/v1/chat/completions" || ${enabled} == false)'>
        <return-response>
          <set-status code="503" reason="Gateway unavailable" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-header name="Cache-Control" exists-action="override">
            <value>no-store</value>
          </set-header>
          <set-body>{"error":{"message":"Gateway unavailable.","type":"service_unavailable","param":null,"code":"gateway_unavailable"}}</set-body>
        </return-response>
      </when>
    </choose>
  </inbound>
  <backend />
  <outbound />
  <on-error>
    <return-response>
      <set-status code="503" reason="Gateway unavailable" />
      <set-header name="Content-Type" exists-action="override">
        <value>application/json</value>
      </set-header>
      <set-header name="Cache-Control" exists-action="override">
        <value>no-store</value>
      </set-header>
      <set-body>{"error":{"message":"Gateway unavailable.","type":"service_unavailable","param":null,"code":"gateway_unavailable"}}</set-body>
    </return-response>
  </on-error>
</policies>
