data "azurerm_resource_group" "existing" {
  name = var.resource_group_name
}

data "azurerm_client_config" "current" {}

locals {
  rg    = data.azurerm_resource_group.existing.name
  rg_id = data.azurerm_resource_group.existing.id
  tags  = { service = "aiflux", environment = "development", inference = "disabled" }
  subnets = {
    appgw    = cidrsubnet(var.address_space, 8, 1)
    apim     = cidrsubnet(var.address_space, 8, 2)
    endpoint = cidrsubnet(var.address_space, 8, 3)
    apps     = cidrsubnet(var.address_space, 8, 4)
    runner   = cidrsubnet(var.address_space, 8, 5)
  }
}

resource "terraform_data" "approval" {
  input = var.deployment_approved
  lifecycle {
    precondition {
      condition     = var.deployment_approved
      error_message = "Prepare/price only until explicit operator infrastructure cost/config approval."
    }
    precondition {
      condition     = var.network_overlap_review_approved && var.egress_approved && var.deployment_identity_approved
      error_message = "Corporate overlap, explicit NAT egress cost/policy, and deployment identity privilege approvals are required."
    }
    precondition {
      condition     = length(trimspace(var.vm_size)) > 0 && can(regex("^ssh-(rsa|ed25519) [A-Za-z0-9+/=]+", var.admin_ssh_public_key))
      error_message = "Supply an approved VM SKU and existing SSH public key; no key is generated by Terraform."
    }
    precondition {
      condition     = data.azurerm_client_config.current.subscription_id == var.subscription_id
      error_message = "Provider subscription must match the explicitly supplied subscription."
    }
  }
}

resource "azurerm_virtual_network" "main" {
  name                = "${var.name_prefix}-vnet"
  location            = var.location
  resource_group_name = local.rg
  address_space       = [var.address_space]
  tags                = local.tags
  depends_on          = [terraform_data.approval]
}

resource "azurerm_subnet" "main" {
  for_each                          = local.subnets
  name                              = "${var.name_prefix}-${each.key}"
  resource_group_name               = local.rg
  virtual_network_name              = azurerm_virtual_network.main.name
  address_prefixes                  = [each.value]
  default_outbound_access_enabled   = false
  private_endpoint_network_policies = each.key == "endpoint" ? "Disabled" : "Enabled"
  dynamic "delegation" {
    for_each = contains(["apim", "apps"], each.key) ? [true] : []
    content {
      name = "azure-service"
      service_delegation {
        name    = "Microsoft.Web/serverFarms"
        actions = ["Microsoft.Network/virtualNetworks/subnets/action"]
      }
    }
  }
}

resource "azurerm_private_dns_zone" "blob" {
  name                = "privatelink.blob.core.windows.net"
  resource_group_name = local.rg
  tags                = local.tags
  depends_on          = [terraform_data.approval]
}

resource "azurerm_private_dns_zone_virtual_network_link" "blob" {
  name                 = "${var.name_prefix}-link"
  private_dns_zone_id  = azurerm_private_dns_zone.blob.id
  virtual_network_id   = azurerm_virtual_network.main.id
  registration_enabled = false
}

resource "azurerm_public_ip" "egress" {
  name                = "${var.name_prefix}-runner-egress"
  location            = var.location
  resource_group_name = local.rg
  allocation_method   = "Static"
  sku                 = "Standard"
  tags                = local.tags
  depends_on          = [terraform_data.approval]
}

resource "azurerm_nat_gateway" "runner" {
  name                    = "${var.name_prefix}-runner-nat"
  location                = var.location
  resource_group_name     = local.rg
  sku_name                = "Standard"
  idle_timeout_in_minutes = 10
  tags                    = local.tags
  depends_on              = [terraform_data.approval]
}

resource "azurerm_nat_gateway_public_ip_association" "runner" {
  nat_gateway_id       = azurerm_nat_gateway.runner.id
  public_ip_address_id = azurerm_public_ip.egress.id
}

resource "azurerm_subnet_nat_gateway_association" "runner" {
  subnet_id      = azurerm_subnet.main["runner"].id
  nat_gateway_id = azurerm_nat_gateway.runner.id
}

resource "azurerm_network_security_group" "runner" {
  name                = "${var.name_prefix}-runner-nsg"
  location            = var.location
  resource_group_name = local.rg
  tags                = local.tags
  security_rule {
    name                       = "DenyAllInbound"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
  dynamic "security_rule" {
    for_each = {
      HttpsInternet = { priority = 100, protocol = "Tcp", ports = ["443"], destination = "Internet" }
      HttpsPrivate  = { priority = 110, protocol = "Tcp", ports = ["443"], destination = "VirtualNetwork" }
      AzureDnsUdp   = { priority = 120, protocol = "Udp", ports = ["53"], destination = "168.63.129.16" }
      AzureDnsTcp   = { priority = 130, protocol = "Tcp", ports = ["53"], destination = "168.63.129.16" }
      AzureVmAgent  = { priority = 140, protocol = "Tcp", ports = ["80", "32526"], destination = "168.63.129.16" }
      AzureIdentity = { priority = 150, protocol = "Tcp", ports = ["80"], destination = "AzurePlatformIMDS" }
    }
    content {
      name                       = security_rule.key
      priority                   = security_rule.value.priority
      direction                  = "Outbound"
      access                     = "Allow"
      protocol                   = security_rule.value.protocol
      source_port_range          = "*"
      destination_port_ranges    = security_rule.value.ports
      source_address_prefix      = "*"
      destination_address_prefix = security_rule.value.destination
    }
  }
  security_rule {
    name                       = "DenyOtherOutbound"
    priority                   = 4096
    direction                  = "Outbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
  depends_on = [terraform_data.approval]
}

resource "azurerm_subnet_network_security_group_association" "runner" {
  subnet_id                 = azurerm_subnet.main["runner"].id
  network_security_group_id = azurerm_network_security_group.runner.id
}

resource "azurerm_user_assigned_identity" "deployment" {
  name                = "${var.name_prefix}-deployment-identity"
  location            = var.location
  resource_group_name = local.rg
  tags                = local.tags
  depends_on          = [terraform_data.approval]
}

resource "azurerm_federated_identity_credential" "deployment" {
  name                      = "github-aiflux-development"
  user_assigned_identity_id = azurerm_user_assigned_identity.deployment.id
  issuer                    = "https://token.actions.githubusercontent.com"
  audience                  = ["api://AzureADTokenExchange"]
  subject                   = "repo:REPLACE_WITH_GITHUB_OWNER/REPLACE_WITH_REPOSITORY:environment:aiflux-development"
}

resource "azurerm_role_assignment" "deployment" {
  for_each             = toset(["Contributor", "Role Based Access Control Administrator"])
  scope                = local.rg_id
  role_definition_name = each.key
  principal_id         = azurerm_user_assigned_identity.deployment.principal_id
}

resource "azurerm_network_interface" "runner" {
  name                = "${var.name_prefix}-runner-nic"
  location            = var.location
  resource_group_name = local.rg
  tags                = local.tags
  ip_configuration {
    name                          = "private"
    subnet_id                     = azurerm_subnet.main["runner"].id
    private_ip_address_allocation = "Dynamic"
  }
}

resource "azurerm_linux_virtual_machine" "runner" {
  name                            = "${var.name_prefix}-runner"
  location                        = var.location
  resource_group_name             = local.rg
  size                            = var.vm_size
  admin_username                  = "operator"
  network_interface_ids           = [azurerm_network_interface.runner.id]
  disable_password_authentication = true
  provision_vm_agent              = true
  secure_boot_enabled             = true
  vtpm_enabled                    = true
  custom_data                     = base64encode(file("${path.module}/cloud-init.yaml"))
  tags                            = local.tags
  admin_ssh_key {
    username   = "operator"
    public_key = var.admin_ssh_public_key
  }
  identity {
    type = "SystemAssigned"
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = var.os_disk.storage_type
    disk_size_gb         = var.os_disk.size_gb
  }
  source_image_reference {
    publisher = "Canonical"
    offer     = "ubuntu-24_04-lts"
    sku       = "server"
    version   = "latest"
  }
  depends_on = [
    azurerm_subnet_network_security_group_association.runner,
    azurerm_subnet_nat_gateway_association.runner,
    azurerm_nat_gateway_public_ip_association.runner,
  ]
}
