<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="aiflux-contracts" name="AIFLUX contracts and conditional edge">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1100">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="legend" value="AIFLUX repository contracts, not live acceptance. Solid: implemented integrations. Dashed: conditional edge requiring TLS/WAF/origin acceptance. Hybrid private data requires reviewed inputs. Subnets are network inputs, not fixed customer CIDRs. See capabilities.md." style="text;whiteSpace=wrap;html=1;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="80" as="geometry"/></mxCell>
        <mxCell id="browser" value="Customer / IDS browser&#xa;Entra SPA PKCE" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="portals" value="React portals: / and /admin/&#xa;Approved direct-dev origins" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="edge" value="Conditional App Gateway WAF HTTPS&#xa;Certificate / origin acceptance unverified" style="rounded=1;whiteSpace=wrap;dashed=1;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="api" value="FastAPI control plane&#xa;Delegated scope + enabled SQL membership&#xa;APIM subscriptions, never inference proxy" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="apim" value="APIM guarded /dev/llm/v1&#xa;Subscription required; eleven dev aliases&#xa;Non-streaming text; explicit translation&#xa;Native /v1 release gate disabled" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="340" y="410" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="clients" value="API clients / SDKs&#xa;Subscription-key header" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="safety" value="Content Safety / Prompt Shields / Language&#xa;Original input, batched PII, redacted input&#xa;Buffered output checked before release" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="700" y="380" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="models" value="OpenAI / Foundry Direct / Anthropic&#xa;Managed identity; model-specific pools/caps&#xa;No tools or conversation store" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="700" y="540" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="logs" value="Monitor metadata logs&#xa;Completeness / no-payload evidence required" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;" vertex="1" parent="1"><mxGeometry x="340" y="620" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="fn" value="Five-minute ingestion Function&#xa;Latest recorded pause: unowned test rows&#xa;Known cost is list-rate showback" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;" vertex="1" parent="1"><mxGeometry x="340" y="780" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="integration" value="API / Function outbound VNet integration&#xa;network.app_service_integration_subnet" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="data" value="Hybrid private endpoints / DNS&#xa;SQL, vault, blob, queue, table&#xa;network.private_endpoint_subnet&#xa;Public access disabled in hybrid mode" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="1040" y="320" width="300" height="110" as="geometry"/></mxCell>
